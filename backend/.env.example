# ─── Which broker ─────────────────────────────────────────────────────────────
# oanda — OANDA v20 REST. Runs anywhere, including Docker on Linux.
# mt5   — MetaTrader 5 terminal (MultiBank, and any other MT5 broker).
#         The backend must run on Windows on the same machine as the terminal:
#         MetaQuotes publishes no Linux build of its Python package.
BROKER=oanda

# ─── Broker: OANDA v20 ────────────────────────────────────────────────────────
# A practice account is free at https://www.oanda.com and is all you need to
# run in paper mode: the agent reads real gold prices through it.
# The API key comes from "Manage API Access"; the account ID is on the dashboard.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice = demo money (default), live = real money
OANDA_ENVIRONMENT=practice

# ─── Broker: MetaTrader 5 (BROKER=mt5) ────────────────────────────────────────
# Login, password and server exactly as they appear in the terminal. For
# MultiBank the server looks like "MultiBankGroup-Live" or "MEXAtlantic-Demo".
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe. Leave empty to attach to a terminal already open.
MT5_TERMINAL_PATH=
# Your broker's exact gold symbol if it is not plain XAUUSD (e.g. XAUUSD.m).
# Leave empty to discover it from the terminal's Market Watch.
MT5_SYMBOL=
# Tags this agent's orders. Positions without this number — anything you open
# by hand — are never read, modified or closed by the agent.
MT5_MAGIC=8829001
# Maximum slippage accepted on a market order, in points.
MT5_SLIPPAGE_POINTS=20
# How many hours the broker's clock runs ahead of UTC. MultiBank servers are
# usually +2 (winter) or +3 (summer). Leave empty to measure it from a live
# tick — but pin it if the log warns that the market looked closed, because a
# wrong value shifts every session window by hours.
MT5_SERVER_UTC_OFFSET_HOURS=

# ─── Execution mode ───────────────────────────────────────────────────────────
# paper: the full pipeline runs and fills are simulated against real quotes.
# live:  orders are sent to the broker. BOTH of the next two must be set for
#        any real order to leave this process.
AGENT_MODE=paper
EXECUTION_CONFIRMED=false
# Start trading as soon as the API boots
AGENT_AUTOSTART=false
SCAN_INTERVAL_SECONDS=60
PAPER_STARTING_BALANCE=10000

# ─── Storage ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/jarves.db

# ─── Risk limits ──────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=2
COOLDOWN_MINUTES=60
MAX_LEVERAGE=5.0

# ─── Trade construction ───────────────────────────────────────────────────────
MIN_RISK_REWARD=2.0
STOP_ATR_MULTIPLE=1.0
MIN_STOP_USD=2.5
MAX_STOP_USD=12.0
BREAKEVEN_AT_R=1.0
TRAIL_START_R=1.5
TRAIL_ATR_MULTIPLE=1.5
MAX_TRADE_HOURS=12

# ─── Market gates ─────────────────────────────────────────────────────────────
SESSION_WINDOWS=07:00-11:00,12:30-17:00
ROLLOVER_WINDOW=20:45-22:15
MAX_SPREAD_USD=0.60
MAX_SPREAD_ATR_RATIO=0.25
MIN_ATR_USD=1.0
MAX_ATR_USD=20.0
MAX_EXTENSION_ATR=2.5

# ─── Economic calendar ────────────────────────────────────────────────────────
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
FLATTEN_BEFORE_NEWS=true
# Optional: a free key from https://fcsapi.com gives real release times.
# Without one the agent falls back to the recurring US release clock.
FCS_API_KEY=
