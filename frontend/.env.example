# Where the agent's API lives, as seen from the machine running this console.
#
# Running locally next to the backend (the normal setup):
BACKEND_URL=http://localhost:8000
#
# Deployed (Vercel and similar): this MUST be a public HTTPS address. A
# deployed console cannot reach localhost or a private IP on your machine —
# the platform refuses to proxy there (Vercel reports
# DNS_HOSTNAME_RESOLVED_PRIVATE). See the README.

# Must match API_TOKEN in backend/.env. It is read server-side by the proxy in
# src/app/api/[...path]/route.ts and never sent to the browser.
API_TOKEN=
